# PUBLIC INTERFACE
# Frontend environment configuration for Micro-Skill LMS (React)
# Copy to .env and adjust values for your environment.

# Base API URL used by the axios client. If both are set, REACT_APP_API_BASE takes precedence.
REACT_APP_API_BASE=http://localhost:3001
# Alternative backend URL (fallback if REACT_APP_API_BASE not set)
REACT_APP_BACKEND_URL=http://localhost:3001

# Frontend absolute URL (used by backends for redirects in some flows)
REACT_APP_FRONTEND_URL=http://localhost:3000

# WebSocket URL if needed in future features
REACT_APP_WS_URL=ws://localhost:3001

# Runtime environment and misc flags
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/
REACT_APP_FEATURE_FLAGS={}
REACT_APP_EXPERIMENTS_ENABLED=false
