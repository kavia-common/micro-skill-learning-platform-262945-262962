{"is_source_file": true, "format": "JavaScript", "description": "This file defines a module that provides an API client created using Axios. It includes functions to create customized Axios instances with authentication headers, manages a singleton default client, and allows setting a token getter function to dynamically retrieve JWT tokens. The primary focus is on configuring HTTP requests for a frontend application communicating with a backend API, handling authorization via Bearer tokens.", "external_files": ["axios"], "external_methods": ["axios.create"], "published": ["createApiClient", "setTokenGetter", "getDefaultApiClient"], "classes": [], "methods": [{"name": "createApiClient(getToken)", "description": "Creates and configures an Axios instance with a base URL, credentials, JSON content type, and an interceptor to attach a Bearer token from a supplied token getter function.", "scope": "", "scopeKind": ""}, {"name": "setTokenGetter(fn)", "description": "Sets a function to retrieve the current JWT token and recreates the default API client to use this new token getter.", "scope": "", "scopeKind": ""}, {"name": "getDefaultApiClient()", "description": "Returns a singleton Axios client instance that uses the current token getter to attach authentication tokens. Creates the instance on first call or if it was recreated after setting a new token getter.", "scope": "", "scopeKind": ""}], "calls": ["axios.create", "instance.interceptors.request.use"], "search-terms": ["createApiClient", "tokenGetter", "AxiosInstance", "Authorization header", "interceptors", "JWT token", "axios"], "state": 2, "file_id": 13, "knowledge_revision": 73, "git_revision": "60e0acd9f165d9431a6a1db6a618a846cac17f87", "revision_history": [{"29": ""}, {"55": ""}, {"56": ""}, {"58": "14db6916d592b1661e6168cde0a34e902e46003e"}, {"73": "60e0acd9f165d9431a6a1db6a618a846cac17f87"}], "ctags": [{"_type": "tag", "name": "createApiClient", "path": "/home/kavia/workspace/code-generation/micro-skill-learni